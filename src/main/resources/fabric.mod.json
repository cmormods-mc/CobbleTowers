{
  "schemaVersion": 1,
  "id": "cobbletowers",
  "version": "${version}",
  "name": "CobbleTowers",
  "description": "Cobblemon Battle Tower runs for solo players and parties of up to four, with boss floors built on CobbleRaids.",
  "authors": ["CMor"],
  "contact": {
    "homepage": "https://github.com/cmormods-mc/CobbleTowers",
    "sources": "https://github.com/cmormods-mc/CobbleTowers",
    "issues": "https://github.com/cmormods-mc/CobbleTowers/issues"
  },
  "license": "MIT",
  "environment": "${environment}",
  "entrypoints": {
    "preLaunch": ["com.cobbletowers.TowerPreLaunch"],
    "main": ["com.cobbletowers.CobbleTowers"]${clientEntrypoint}
  },
  "accessWidener": "cobbletowers.accesswidener",
  "mixins": ["mixins/cobbletowers.mixins.json"],
  "depends": {
    "fabricloader": ">=0.17.2",
    "fabric-api": ">=0.116.6+1.21.1",
    "minecraft": "1.21.1",
    "java": ">=21",
    "polymer-core": ">=0.9.19",
    "polymer-resource-pack": ">=0.9.19",
    "polymer-virtual-entity": ">=0.9.19",
    "cobblemon": ">=1.8.2",
    "cobbleraids": ">=0.8.162-admin-helper"
  },
  "suggests": {
    "webgui": ">=1.8.1"
  }
}
