 "units_per_block": 16,
 "coordinate_contract": {
  "space": "vault space: model units, x east, y up, z south; the model FRONT is the north face (-z); the floor is y = 0",
  "root": "the vault block's floor centre, i.e. model point (8, 0, 8); every display entity is spawned at the root with yaw 0 and transform-only facing (see composition)",
  "display_origin": "an item display draws its model centred on the entity, so model point (8, 8, 8) sits at root + (0, 0.5, 0) blocks: the rest translation of every persistent piece is (0, 0.5, 0); its rest rotation SENT is rotY(180) = (0, 1, 0, 0) xyzw (the client's own half turn then cancels it, so the model stands in vault space: front north)",
  "scale": [
   1,
   1,
   1
  ],
  "display_transform": "none (the item display default, no display override in the model JSON)",
  "hinge": {
   "axis": "x",
   "point_units": [
    8.0,
    15.65,
    17.8
   ],
   "point_root_local_blocks": [
    0.0,
    0.978125,
    0.6125
   ],
   "positive_direction": "positive rotation about +x lifts the lid's FRONT edge (opens); angle = lid.rot_x_deg",
   "max_open_deg": 112.0,
   "peak_overshoot_deg": 116.0
  },
  "facing_yaw_deg": {
   "north": 0.0,
   "west": 90.0,
   "south": 180.0,
   "east": -90.0
  },
  "client_item_display_flip": "Minecraft's item display renderer turns the item MODEL a half circle about y inside its own frame, after the transformation: the client draws T + q (F v) with F = rotY(180). At identity the model's north face looks south (verified in a real 1.21.1 client). The flip acts on the model only, not on the translation.",
  "composition": "Intended pose = Rnet (Tc + R v). For the lid Tc = H + R(c - H), R = rotX(lid.rot_x_deg), H = hinge (root-local blocks), c = (0, 0.5, 0); that is root x translate(H) x R x translate(-H) x rest, no second offset anywhere. Other pieces: Tc = c (+ (0, 0, press/16) for face_plate), R = identity. All get + (root.x_units/16, 0, 0) first. Rnet = rotY(facing_yaw_deg) (north 0, west 90, south 180, east -90). SENT to the client: translation T = Rnet Tc, left rotation q = Rnet R F with F = rotY(180) (so the client's own F cancels); entity yaw stays 0.",
  "interpolation": "every tick the server sends the sampled transformation with interpolation_duration = 1 tick (one sample per tick, so rotation about the hinge follows the arc instead of cutting the chord)"
 },
